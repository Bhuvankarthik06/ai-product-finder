# --- Database ---
# MySQL (matches the resume project):
DATABASE_URL=mysql+pymysql://root:yourpassword@localhost:3306/product_finder
# Quick start without MySQL (leave DATABASE_URL unset to use SQLite):
# DATABASE_URL=sqlite:///products.db

# --- LLM assistant (optional) ---
# Without a key the assistant falls back to a built-in rule-based parser.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5
